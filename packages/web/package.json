{
	"name": "@qr-render/web",
	"version": "0.2.0",
	"description": "The modern, zero-dependency successor to qrcodejs. Built in TypeScript for the web, focusing on performance and type-safety for Canvas rendering",
	"keywords": [
		"canvas",
		"ems",
		"qrcode",
		"tree-shaking",
		"typescript",
		"web",
		"zero-dependency"
	],
	"homepage": "https://github.com/OctaEDLP00/QrRender#readme",
	"bugs": {
		"url": "https://github.com/OctaEDLP00/QrRender/issues"
	},
	"license": "MIT",
	"author": "OctaEDLP00",
	"repository": {
		"type": "git",
		"url": "https://github.com/OctaEDLP00/QrRender.git",
		"directory": "packages/web"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"package.json",
		"tsconfig.json"
	],
	"type": "module",
	"browser": "./dist/index.browser.js",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./qrSvg": {
			"types": "./dist/qrSvg.d.mts",
			"import": "./dist/qrSvg.mjs",
			"default": "./dist/qrSvg.mjs"
		},
		"./preact": {
			"types": "./dist/preact.d.mts",
			"import": "./dist/preact.mjs",
			"default": "./dist/preact.mjs"
		},
		"./svelte": {
			"types": "./dist/QRCode.svelte.d.ts",
			"import": "./dist/QRCode.svelte",
			"default": "./dist/QRCode.svelte"
		},
		"./astro": "./dist/QrCode.astro",
		"./element": {
			"types": "./dist/element.d.mts",
			"import": "./dist/element.mjs",
			"default": "./dist/element.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"lint": "oxlint src/**/*.ts",
		"lint:fix": "oxlint src/**/*.ts --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:run": "vitest run",
		"test:ui": "vitest --ui",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@qr-render/core": "workspace:*"
	},
	"peerDependencies": {
		"preact": "^10.13.0",
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"preact": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	}
}
