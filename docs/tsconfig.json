{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"compilerOptions": {
		"strict": true,
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2022", "dom", "dom.iterable"],
		"noEmit": true,
		"useDefineForClassFields": true
	},
	"include": ["src/components/**/*.ts"]
}
