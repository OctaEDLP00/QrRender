{
	"name": "qr-render",
	"version": "0.1.0",
	"private": true,
	"description": "Multi-package monorepo for the @qr-render suite: a zero-dependency QR core with a web (Canvas) and a CLI (terminal) package on top of it",
	"license": "MIT",
	"author": "OctaEDLP00",
	"scripts": {
		"build": "pnpm -r build",
		"build:core": "pnpm --filter @qr-render/core build",
		"build:web": "pnpm --filter @qr-render/web build",
		"build:cli": "pnpm --filter @qr-render/cli build",
		"fmt": "pnpm -r fmt",
		"fmt:check": "pnpm -r fmt:check",
		"lint": "pnpm -r lint",
		"lint:fix": "pnpm -r lint:fix",
		"test": "pnpm -r test",
		"test:run": "pnpm -r test:run",
		"test:coverage": "pnpm -r test:coverage",
		"type-check": "pnpm -r type-check",
		"docs": "node tools/build-docs.mjs && node tools/serve-docs.mjs",
		"docs:build": "node tools/build-docs.mjs",
		"docs:type-check": "tsc -p docs/tsconfig.json",
		"commitlint": "commitlint",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "changeset publish",
		"prepare": "husky"
	},
	"devDependencies": {
		"@astrojs/compiler": "^4.0.0",
		"@changesets/cli": "3.0.3",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"@vitest/ui": "5.0.5",
		"esbuild": "0.28.2",
		"happy-dom": "21.0.3",
		"husky": "9.1.7",
		"jsqr": "1.4.0",
		"oxfmt": "0.73.0",
		"oxlint": "1.88.0",
		"pngjs": "7.0.0",
		"preact": "^11.0.1",
		"shiki": "4.5.0",
		"svelte": "^5.57.2",
		"tsdown": "0.23.1",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.0.5",
		"vitest-canvas-mock": "1.2.0"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@12.14.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
